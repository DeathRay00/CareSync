# ================================================================
# Copy this file to .env and fill in your values
# cp .env.example .env
# ================================================================

# ─── Database ────────────────────────────────────────────────────
DB_USER=meduser
DB_PASSWORD=medpassword
DB_NAME=SumitraRaj Hospital

# ─── Backend (FastAPI) ───────────────────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-secret-key

# Google Gemini API key — get one at https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here

# Origins the backend allows (comma-separated)
# For Docker: http://localhost:3000
# For devtunnels: add tunnel URL here too
FRONTEND_URL=http://localhost:3000

# ─── Frontend (Next.js) ──────────────────────────────────────────
# URL the browser uses to reach the backend
# For local dev:       http://localhost:8000
# For Docker on same machine: http://localhost:8000
# For remote/tunnel:  https://your-backend-tunnel.devtunnels.ms
NEXT_PUBLIC_API_URL=http://localhost:8000
